<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0e17" />
      <stop offset="100%" stop-color="#121a2b" />
    </linearGradient>
    <linearGradient id="cyan" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f3ff" />
      <stop offset="100%" stop-color="#0088ff" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg)"/>
  <rect x="50" y="50" width="700" height="400" rx="20" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="2"/>
  <g transform="translate(350, 160)">
    <rect x="0" y="0" width="100" height="120" rx="12" fill="url(#cyan)" opacity="0.15" stroke="#00f3ff" stroke-width="3"/>
    <text x="50" y="75" font-family="'Outfit', sans-serif" font-size="54" font-weight="bold" fill="#00f3ff" text-anchor="middle">P</text>
  </g>
  <text x="400" y="330" font-family="'Outfit', sans-serif" font-size="32" font-weight="bold" fill="#ffffff" text-anchor="middle">SMART PARKING</text>
  <text x="400" y="370" font-family="'Inter', sans-serif" font-size="18" fill="#94a3b8" text-anchor="middle">Smart Mall Parking Destination</text>
</svg>
